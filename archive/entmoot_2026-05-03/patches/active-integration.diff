+            if "tensor_weights" in cluster:
+                if not _is_mapping(cluster["tensor_weights"]):
+                    _fail(path, f"{where}.tensor_weights", "must be a mapping")
+                for tensor_name, weights in cluster["tensor_weights"].items():
+                    if not isinstance(tensor_name, str) or not tensor_name:
