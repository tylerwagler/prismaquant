+    """Shrink a router-shaped tensor to K rows for an Entmoot plan.
+
+    Default strategy is anchor-row routing. A manifest may opt into
+    `router_strategy="weighted_average"` for experimental row averaging,
+    but exact cluster-probability routing would need model-code changes.
+    """
+    n_orig = int(entry["num_experts_orig"])
+    if tensor.shape[0] != n_orig:
+        raise RuntimeError(
+            f"[export-stream] entmoot: router first dim ({tensor.shape[0]}) "
+            f"!= manifest num_experts_orig ({n_orig}). Manifest was built "
+            f"against a different model — refusing to shrink."
+        )
+    strategy = entry.get("router_strategy", "anchor")
+    if strategy in ("anchor", "anchor_rows"):
+        idx = torch.as_tensor(
+            entry["kept_expert_ids"], dtype=torch.long, device=tensor.device,
+        )
+        return tensor.index_select(0, idx).contiguous()
