+def _validate_cluster_weights(value, expected_ids: set[int], path: str | None, where: str) -> None:
+    if not _is_mapping(value):
+        _fail(path, where, "must be a mapping")
+    seen: set[int] = set()
+    total = 0.0
+    for eid, weight in value.items():
+        eid_int = _parse_eid(eid, path, f"{where} key")
+        w = _as_number(weight, path, f"{where}[{eid!r}]")
