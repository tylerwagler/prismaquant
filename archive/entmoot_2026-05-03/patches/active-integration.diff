+def _resolve_linear_merge_action(
+    full_qname: str,
+    merge_by_parent: dict[str, dict],
+) -> tuple[str, dict] | None:
+    """Map a live qname to an Entmoot merge action.
+
+    Returns:
+      ("router", entry) — shrink/merge router rows to K rows.
+      ("merge", entry) — this original expert tensor contributes to a
+                         new dense expert slot; `new_full` is the output
+                         qname and `cluster_weight` is its coefficient.
+    """
+    if not merge_by_parent:
+        return None
+    parent = full_qname.rsplit(".", 1)[0]
+    entry = merge_by_parent.get(parent)
+    if entry is not None and entry["router_qname"] == full_qname:
+        return "router", entry
+
+    m = _EXPERT_IDX_IN_QNAME_RE.match(full_qname)
+    if m is None:
+        return None
+    parent = m.group("parent")
+    entry = merge_by_parent.get(parent)
+    if entry is None:
+        return None
+    try:
+        eid = int(m.group("eid"))
+    except (TypeError, ValueError):
+        return None
+    mapping = entry["orig_to_new_eid"]
+    new_eid = mapping.get(str(eid), mapping.get(eid))
+    if new_eid is None:
+        return None
+    new_eid = int(new_eid)
+    rest = m.group("rest")
+    new_full = (
+        f"{parent}.experts.{new_eid}.{rest}" if rest
+        else f"{parent}.experts.{new_eid}"
+    )
+    anchor_eid = None
+    for cluster in entry.get("clusters", []):
+        if int(cluster.get("new_expert_id", -1)) == new_eid:
+            anchor_eid = int(cluster["anchor_expert_id"])
+            break
+    if anchor_eid is None:
+        anchor_eid = int(entry["kept_expert_ids"][new_eid])
+    anchor_full = (
+        f"{parent}.experts.{anchor_eid}.{rest}" if rest
+        else f"{parent}.experts.{anchor_eid}"
+    )
+    weights = _cluster_weight_by_orig(entry, new_eid)
+    out_entry = dict(entry)
+    out_entry["new_full"] = new_full
+    out_entry["anchor_full"] = anchor_full
+    out_entry["orig_eid"] = eid
+    out_entry["new_eid"] = new_eid
+    out_entry["cluster_weight"] = float(weights[eid])
